LIVEKIT_URL=<your LiveKit server URL>
LIVEKIT_API_KEY=<your API Key>
LIVEKIT_API_SECRET=<your API Secret>
OPENROUTER_API_KEY=<your OpenRouter API Key>
OPENAI_API_KEY=<your OpenAI API Key, only needed if LLM_PROVIDER=openai or no OpenRouter key>
DEEPGRAM_API_KEY=<your Deepgram API Key>
CARTESIA_API_KEY=<your Cartesia API Key>
SARVAM_API_KEY=<your Sarvam API Key>
SIP_OUTBOUND_TRUNK_ID=<your SIP Outbound Trunk ID>

# Webhook configuration for call status updates
WEBHOOK_URL=<your webhook URL, e.g., https://yourdomain.com/api/webhooks/call-status>
WEBHOOK_SECRET=<your webhook secret key for HMAC authentication>

# --- Optional model settings (defaults shown; leave unset or blank to use the default) ---
# In GitHub deploy Variables, separate list values with ';' instead of ',' (e.g. hi;hinglish)

# LLM
# LLM_PROVIDER=openrouter                 # openrouter | openai
# LLM_MODEL=openai/gpt-4.1-mini           # any OpenRouter model id, e.g. google/gemini-2.5-flash
# LLM_FALLBACK_MODELS=                    # OpenRouter models separated by , or ;, e.g. google/gemini-2.5-flash

# English speech (Deepgram STT + Cartesia TTS)
# STT_MODEL=nova-3
# STT_LANGUAGE=multi
# TTS_MODEL=sonic-3

# Hindi / Hinglish speech (Sarvam)
# SARVAM_LANGUAGES=hi,hinglish            # , or ; separated; "none" = use Deepgram + Cartesia for everything
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v2
